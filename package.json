{
  "name": "fullstack-monorepo",
  "scripts": {
    "start:front": "npm run start --prefix ./apps/front-app",
    "start:api": "npm run start:dev --prefix ./apps/api-app",
    "start:db": "docker compose up -d postgres_db",
    "start:all": "npm run start:postgres_db && npm run start:api & npm run start:front",
    "stop:db": "docker compose down"
  }
}